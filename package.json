{
  "name": "library-catalog-compilation",
  "version": "1.0.0",
  "description": "Internal catalog tool for compiling library author records.",
  "main": "src/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:reset": "node scripts/dev/reset-database.js",
    "test": "npm run test:backend && npm run test:preprocessing",
    "test:backend": "node --test",
    "test:preprocessing": "python -B -m unittest discover -s src/preprocessing -p \"test*.py\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ethan-sexton/library-catalog-compilation.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ethan-sexton/library-catalog-compilation/issues"
  },
  "homepage": "https://github.com/Ethan-sexton/library-catalog-compilation#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
